module ChessTest where

import Daml.Script
import DA.Assert ((===))
import DA.TextMap qualified as TextMap
import Chess

-- Helpers ----------------------------------------------------------------------

-- | alice challenges bob and plays Black, so bob is White and moves first.
startGame : Script (Party, Party, Party, ContractId Game)
startGame = do
  alice <- allocateParty "alice"
  bob <- allocateParty "bob"
  lobby <- allocateParty "lobby"
  c <- submit alice do
    createCmd Challenge with creator = alice; opponent = bob; lobby; creatorColor = Black
  g <- submit bob do exerciseCmd c Accept
  pure (alice, bob, lobby, g)

-- | A game in an arbitrary position (bob is White, alice is Black).
gameFromFen : Text -> Script (Party, Party, ContractId Game)
gameFromFen f = do
  alice <- allocateParty "alice"
  bob <- allocateParty "bob"
  g <- submitMulti [alice, bob] [] do
    createCmd Game with white = bob; black = alice; fen = f; drawOfferedBy = None; positions = TextMap.empty
  pure (alice, bob, g)

-- | A move that must leave the game running: yields the next game.
move : Party -> ContractId Game -> Text -> Commands (ContractId Game)
move p g san = fmap continued (moveResult p g san)

moveResult : Party -> ContractId Game -> Text -> Commands MoveResult
moveResult p g san = exerciseCmd g Move with actor = p; san

continued : MoveResult -> ContractId Game
continued (Continued g) = g
continued (Finished _) = error "the game ended"

-- | The result of a move that must end the game.
finished : MoveResult -> ContractId GameResult
finished (Finished r) = r
finished (Continued _) = error "the game did not end"

fenOf : Party -> ContractId Game -> Script Text
fenOf p g = do
  Some game <- queryContractId p g
  pure game.fen

-- | Play moves in order; the player to move is taken from the position.
play : (Party, Party) -> ContractId Game -> [Text] -> Script (ContractId Game)
play _ g [] = pure g
play (white, black) g (san :: rest) = do
  f <- fenOf white g
  let p = if (parseFen f).turn == White then white else black
  g' <- submit p do move p g san
  play (white, black) g' rest

-- | Number of legal move sequences of the given length.
perft : Int -> Position -> Int
perft 0 _ = 1
perft 1 pos = length (legalMoves pos)
perft d pos = sum (map (\m -> perft (d - 1) (applyMv pos m)) (legalMoves pos))

-- FEN and move generation -----------------------------------------------------------

fenRoundTrip : Script ()
fenRoundTrip = do
  serializeFen (parseFen startFen) === startFen
  let busy = "r3k2r/p1ppqpb1/bn2pnp1/3PN3/1p2P3/2N2Q1p/PPPBBPPP/R3K2R b KQkq - 3 2"
  serializeFen (parseFen busy) === busy
  let sparse = "8/8/4k3/8/8/4K3/8/8 w - - 0 1"
  serializeFen (parseFen sparse) === sparse
  TextMap.size (parseFen startFen).board === 32
  (parseFen startFen).castling === "KQkq"

-- Reference node counts from https://www.chessprogramming.org/Perft_Results. They exercise castling,
-- en passant, promotion and pins, so they cover the whole move generator.
perftStartingPosition : Script ()
perftStartingPosition = do
  let p = parseFen startFen
  perft 1 p === 20
  perft 2 p === 400
  perft 3 p === 8902

perftKiwipete : Script ()
perftKiwipete = do
  let p = parseFen "r3k2r/p1ppqpb1/bn2pnp1/3PN3/1p2P3/2N2Q1p/PPPBBPPP/R3K2R w KQkq - 0 1"
  perft 1 p === 48
  perft 2 p === 2039

perftEndgameWithEnPassant : Script ()
perftEndgameWithEnPassant = do
  let p = parseFen "8/2p5/3p4/KP5r/1R3p1k/8/4P1P1/8 w - - 0 1"
  perft 1 p === 14
  perft 2 p === 191
  perft 3 p === 2812

perftPromotionsAndCastling : Script ()
perftPromotionsAndCastling = do
  let p4 = parseFen "r3k2r/Pppp1ppp/1b3nbN/nP6/BBP1P3/q4N2/Pp1P2PP/R2Q1RK1 w kq - 0 1"
  perft 1 p4 === 6
  perft 2 p4 === 264
  perft 3 p4 === 9467
  let p5 = parseFen "rnbq1k1r/pp1Pbppp/2p5/8/2B5/8/PPP1NnPP/RNBQK2R w KQ - 1 8"
  perft 1 p5 === 44
  perft 2 p5 === 1486
  let p6 = parseFen "r4rk1/1pp1qppp/p1np1n2/2b1p1B1/2B1P1b1/P1NP1N2/1PP1QPPP/R4RK1 w - - 0 10"
  perft 1 p6 === 46
  perft 2 p6 === 2079

-- Challenges ---------------------------------------------------------------------

challengeAccept : Script ()
challengeAccept = do
  alice <- allocateParty "alice"
  bob <- allocateParty "bob"
  lobby <- allocateParty "lobby"
  c <- submit alice do
    createCmd Challenge with creator = alice; opponent = bob; lobby; creatorColor = Black
  -- lobby sees the open challenge
  open <- query @Challenge lobby
  length open === 1
  g <- submit bob do exerciseCmd c Accept
  Some game <- queryContractId alice g
  game.white === bob
  game.black === alice
  game.fen === startFen
  -- the challenge is gone, and the lobby no longer sees it
  none <- query @Challenge lobby
  length none === 0

-- | Who has to sign what: a challenge only needs its creator, a game needs both players.
authorization : Script ()
authorization = do
  alice <- allocateParty "alice"
  bob <- allocateParty "bob"
  lobby <- allocateParty "lobby"
  let challenge = Challenge with creator = alice; opponent = bob; lobby; creatorColor = Black
  -- alice alone can challenge; nobody can challenge in alice's name
  submitMustFail bob do createCmd challenge
  c <- submit alice do createCmd challenge
  -- the opponent alone can accept (the creator's authority comes from the challenge): both end up signatories
  submitMustFail alice do exerciseCmd c Accept
  submitMustFail lobby do exerciseCmd c Accept
  -- a game cannot be created with the signature of one player only
  let game = Game with white = bob; black = alice; fen = startFen; drawOfferedBy = None; positions = TextMap.empty
  submitMustFail alice do createCmd game
  submitMustFail bob do createCmd game
  g <- submit bob do exerciseCmd c Accept
  -- both players see it, the lobby does not
  Some _ <- queryContractId alice g
  Some _ <- queryContractId bob g
  None <- queryContractId lobby g
  -- an outsider can neither move nor resign
  submitMustFail lobby do exerciseCmd g Resign with actor = lobby
  submitMustFail alice do exerciseCmd g Resign with actor = bob
  pure ()

challengeRejected : Script ()
challengeRejected = do
  alice <- allocateParty "alice"
  bob <- allocateParty "bob"
  lobby <- allocateParty "lobby"
  -- cannot challenge yourself
  submitMustFail alice do
    createCmd Challenge with creator = alice; opponent = alice; lobby; creatorColor = White
  c <- submit alice do
    createCmd Challenge with creator = alice; opponent = bob; lobby; creatorColor = White
  -- only the opponent may accept
  submitMustFail alice do exerciseCmd c Accept
  submit bob do exerciseCmd c Decline

-- Moves --------------------------------------------------------------------------

moves : Script ()
moves = do
  (alice, bob, _, g0) <- startGame
  -- alice (black) cannot move first
  submitMustFail alice do move alice g0 "e5"
  -- illegal for bob: a pawn cannot jump three squares, the king is blocked, there is no such knight move
  submitMustFail bob do move bob g0 "e5"
  submitMustFail bob do move bob g0 "Ke2"
  submitMustFail bob do move bob g0 "Nf6"
  submitMustFail bob do move bob g0 "nonsense"
  g1 <- submit bob do move bob g0 "e4"
  fenOf alice g1 >>= (=== "rnbqkbnr/pppppppp/8/8/4P3/8/PPPP1PPP/RNBQKBNR b KQkq e3 0 1")
  -- the old version is archived
  old <- queryContractId alice g0
  old === None
  -- now it is black's turn, not white's
  submitMustFail bob do move bob g1 "d4"
  g2 <- submit alice do move alice g1 "e5"
  g3 <- submit bob do move bob g2 "Nf3"
  -- a knight move is neither a pawn move nor a capture: the halfmove clock counts up
  fenOf bob g3 >>= (=== "rnbqkbnr/pppp1ppp/8/4p3/4P3/5N2/PPPP1PPP/RNBQKB1R b KQkq - 1 2")

-- | chess.js writes check and mate suffixes; the ledger accepts them. Long algebraic ("e2e4") works too.
notationVariants : Script ()
notationVariants = do
  (alice, bob, _, g0) <- startGame
  g1 <- submit bob do move bob g0 "e2e4"
  g2 <- submit alice do move alice g1 "e5"
  g3 <- play (bob, alice) g2 ["Bc4", "Nc6", "Qh5", "Nf6"]
  -- the mate ends the game: black is checkmated, white wins
  r <- submit bob do finished <$> moveResult bob g3 "Qxf7#"
  Some result <- queryContractId alice r
  result.outcome === WhiteWins
  result.reason === "checkmate"
  result.fen === "r1bqkb1r/pppp1Qpp/2n2n2/4p3/2B1P3/8/PPPP1PPP/RNB1K1NR b KQkq - 0 4"
  open <- query @Game bob
  length open === 0
  let p = parseFen result.fen
  length (legalMoves p) === 0
  inCheck p.board p.turn === True
  -- a capture without the "x" is not the move that was meant
  (alice2, bob2, h0) <- gameFromFen "4k3/8/8/8/8/8/4r3/4R1K1 w - - 0 1"
  submitMustFail bob2 do move bob2 h0 "Ree2"
  pure ()

-- Game endings and history ----------------------------------------------------------

stalemate : Script ()
stalemate = do
  let p = parseFen "7k/5Q2/6K1/8/8/8/8/8 b - - 0 1"
  length (legalMoves p) === 0
  inCheck p.board p.turn === False
  -- reaching it ends the game as a draw
  (alice, bob, g) <- gameFromFen "7k/8/5K2/8/8/8/8/6Q1 w - - 0 1"
  r <- submit bob do finished <$> moveResult bob g "Qg6"
  Some result <- queryContractId alice r
  result.outcome === Drawn
  result.reason === "stalemate"

insufficientMaterialEndsTheGame : Script ()
insufficientMaterialEndsTheGame = do
  -- the bishop takes the last knight: king and bishop against a bare king
  (alice, bob, g) <- gameFromFen "4k3/8/8/8/8/8/n7/1B2K3 w - - 0 1"
  r <- submit bob do finished <$> moveResult bob g "Bxa2"
  Some result <- queryContractId alice r
  result.outcome === Drawn
  result.reason === "insufficient material"
  -- two minor pieces are not covered by the rule: the game goes on
  (_, bob2, g2) <- gameFromFen "4k3/8/8/8/8/8/n7/1B2KN2 w - - 0 1"
  submit bob2 do move bob2 g2 "Bxa2"
  pure ()

seventyFiveMoveRule : Script ()
seventyFiveMoveRule = do
  (alice, bob, g) <- gameFromFen "4k3/8/8/8/8/8/8/R3K3 w - - 148 80"
  -- 149 halfmoves: still a game
  g1 <- submit bob do move bob g "Ra2"
  fenOf alice g1 >>= (=== "4k3/8/8/8/8/8/R7/4K3 b - - 149 80")
  -- the 150th halfmove ends it
  r <- submit alice do finished <$> moveResult alice g1 "Kd7"
  Some result <- queryContractId bob r
  result.outcome === Drawn
  result.reason === "75-move rule"

threefoldRepetition : Script ()
threefoldRepetition = do
  (alice, bob, _, g0) <- startGame
  -- the knights go out and back twice: the starting position occurs a third time on the last move
  g <- play (bob, alice) g0 ["Nf3", "Nf6", "Ng1", "Ng8", "Nf3", "Nf6", "Ng1"]
  Some game <- queryContractId bob g
  -- the starting position has occurred twice so far
  TextMap.lookup "rnbqkbnr/pppppppp/8/8/8/8/PPPPPPPP/RNBQKBNR w KQkq -" game.positions === Some 2
  r <- submit alice do finished <$> moveResult alice g "Ng8"
  Some result <- queryContractId bob r
  result.outcome === Drawn
  result.reason === "threefold repetition"

-- | A pawn move or capture resets the repetition counts: positions before it can never recur.
repetitionCountsResetOnIrreversibleMoves : Script ()
repetitionCountsResetOnIrreversibleMoves = do
  (alice, bob, _, g0) <- startGame
  g <- play (bob, alice) g0 ["Nf3", "Nf6", "Ng1", "Ng8", "e4"]
  Some game <- queryContractId bob g
  TextMap.size game.positions === 1
