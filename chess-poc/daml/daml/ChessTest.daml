module ChessTest where

import Daml.Script
import DA.Assert ((===))
import DA.TextMap qualified as TextMap
import Chess

challengeAccept : Script ()
challengeAccept = do
  alice <- allocateParty "alice"
  bob <- allocateParty "bob"
  lobby <- allocateParty "lobby"

  c <- submit alice do
    createCmd Challenge with creator = alice; opponent = bob; lobby; creatorColor = Black

  -- lobby sees the open challenge
  open <- query @Challenge lobby
  length open === 1

  g <- submit bob do exerciseCmd c Accept
  Some game <- queryContractId alice g
  game.white === bob
  game.black === alice
  game.turn === White
  TextMap.size game.board === 32

  -- the challenge is gone, and the lobby no longer sees it
  none <- query @Challenge lobby
  length none === 0

challengeRejected : Script ()
challengeRejected = do
  alice <- allocateParty "alice"
  bob <- allocateParty "bob"
  lobby <- allocateParty "lobby"
  -- cannot challenge yourself
  submitMustFail alice do
    createCmd Challenge with creator = alice; opponent = alice; lobby; creatorColor = White
  c <- submit alice do
    createCmd Challenge with creator = alice; opponent = bob; lobby; creatorColor = White
  -- only the opponent may accept
  submitMustFail alice do exerciseCmd c Accept
  submit bob do exerciseCmd c Decline
